# ═══════════════════════════════════════════════════════════════════════════
# StreetSync monorepo – unified environment variables
# Copy to .env (root) and/or per-package .env. Keys below are the full set;
# each package only reads the subset it needs (mapping noted per key).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Chain / RPC ────────────────────────────────────────────────────────────
# Arc Testnet RPC endpoint (contracts hardhat.config.ts, backend indexer)
# Aliases read by code: ARC_RPC_URL (contracts, backend)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Local Hardhat node (optional local dev)
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Chain ID: 5042002 = Arc Testnet (default), 31337 = local Hardhat
CHAIN_ID=5042002

# ─── USDC ───────────────────────────────────────────────────────────────────
# Existing 6-decimal USDC on Arc Testnet. Leave unset to auto-deploy MockUSDC.
ARC_USDC_ADDRESS=

# ─── Keys ───────────────────────────────────────────────────────────────────
# Deployer wallet (contracts deploy)
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Backend EIP-712 attestation signer (backend/src/signer.ts)
ATTESTER_PRIVATE_KEY=0xYOUR_ATTESTER_PRIVATE_KEY

# Address of the ATTESTER_PRIVATE_KEY wallet — must equal the attester set in
# the StreetSyncEscrow deployment (contracts deploy script + backend).
ATTESTER_SIGNER_ADDRESS=0xYOUR_ATTESTER_ADDRESS

# ─── World ID v4 ────────────────────────────────────────────────────────────
# From https://developer.worldcoin.org (app_staging_... / app_...)
WORLD_APP_ID=app_YOUR_WORLD_APP_ID

# Action namespace/prefix for World ID actions (worker/reviewer actions are
# derived from it, e.g. <prefix>-worker, <prefix>-reviewer)
WORLD_ACTION_PREFIX=streetsync

# Dev-only: allow POST /api/worldid/verify to proceed when the World ID API is
# unreachable. NEVER set in production; requests must also send dev_bypass=true.
ALLOW_DEV_WORLD_ID_BYPASS=false

# ─── Arkiv ──────────────────────────────────────────────────────────────────
# Arkiv gateway RPC / endpoint for evidence entity storage
ARKIV_RPC_URL=https://arp.testnet.arkiv.golem.network
ARKIV_PRIVATE_KEY=0xYOUR_ARKIV_PRIVATE_KEY

# ─── Ethereum Swarm (Video Walkthrough Storage) ─────────────────────────────
# Public gateway (https://api.gateway.ethswarm.org) or local Bee node (http://localhost:1633)
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
# Optional: 64-char hex postage batch ID for live Bee uploads
SWARM_POSTAGE_BATCH_ID=
# Mode: "auto", "live", or "mock" (auto uses Bee if reachable, with seamless 4s local fallback)
SWARM_MODE=auto

# ─── App (frontend) ─────────────────────────────────────────────────────────
# WalletConnect project ID (app only; from https://reown.com)
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WC_PROJECT_ID

NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_LOCALHOST_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORLD_APP_ID=app_staging_streetsync
NEXT_PUBLIC_WORLD_ACTION_WORKER=claim-bounty
NEXT_PUBLIC_WORLD_ACTION_REVIEWER=register-reviewer
NEXT_PUBLIC_ARKIV_MODE=local
NEXT_PUBLIC_ARKIV_URL=https://arp.testnet.arkiv.golem.network
NEXT_PUBLIC_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
NEXT_PUBLIC_SWARM_POSTAGE_BATCH_ID=
NEXT_PUBLIC_SWARM_MODE=auto

# Optional contract address overrides (skip contracts/deployments/<network>.json)
# NEXT_PUBLIC_ESCROW_ADDRESS=0x...
# NEXT_PUBLIC_USDC_ADDRESS=0x...

# ─── Deploy / windows / backend ─────────────────────────────────────────────
ATTESTER_ADDRESS=0xYOUR_ATTESTER_ADDRESS
ESCROW_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_ESCROW_ADDRESS
DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet.json
BACKEND_PORT=3001
HOST=0.0.0.0
DB_PATH=data/streetsync.db
# COMMIT_WINDOW=300
# REVEAL_WINDOW=300
# CLAIM_DURATION=3600

# ─── JanLekha (Arc Testnet registries) ───────────────────────────────────────
# Eight registries ported from the JanLekha Foundry sources into the
# Hardhat contracts project. All empty until deployed; see
# docs/ARC-MIGRATION.md. The backend indexer reads these addresses (or
# the deployment artifact) and the app reads the NEXT_PUBLIC_* copies.
# Testnet only, demo data only.
JANLEKHA_ROLE_REGISTRY_ADDRESS=
JANLEKHA_BUDGET_REGISTRY_ADDRESS=
JANLEKHA_PROJECT_REGISTRY_ADDRESS=
JANLEKHA_PROCUREMENT_REGISTRY_ADDRESS=
JANLEKHA_MILESTONE_REGISTRY_ADDRESS=
JANLEKHA_PAYMENT_REGISTRY_ADDRESS=
JANLEKHA_DOCUMENT_REGISTRY_ADDRESS=
JANLEKHA_AUDIT_REGISTRY_ADDRESS=
JANLEKHA_DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet-janlekha.json
JANLEKHA_DEPLOYMENT_BLOCK=

# ─── JanLekha World ID (citizen participation only) ──────────────────────────
# Optional separate World ID app for JanLekha; when empty the shared
# WORLD_APP_ID / WORLD_RP_ID are used. Missing ids make
# POST /api/worldid/janlekha/verify fail closed (503). World ID proves
# uniqueness only; it grants no official JanLekha role.
JANLEKHA_WORLD_APP_ID=
JANLEKHA_WORLD_RP_ID=
NEXT_PUBLIC_JANLEKHA_WORLD_APP_ID=
# JanLekha World ID actions are derived per item by the backend:
# janlekha-feedback-<projectId>, janlekha-complaint-<projectId>,
# janlekha-community-review-<milestoneId>.
NEXT_PUBLIC_JANLEKHA_WORLD_ACTION_FEEDBACK=janlekha-feedback
NEXT_PUBLIC_JANLEKHA_WORLD_ACTION_COMPLAINT=janlekha-complaint
NEXT_PUBLIC_JANLEKHA_WORLD_ACTION_COMMUNITY_REVIEW=janlekha-community-review
NEXT_PUBLIC_JANLEKHA_ROLE_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_BUDGET_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_PROJECT_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_PROCUREMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_MILESTONE_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_PAYMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_DOCUMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_JANLEKHA_AUDIT_REGISTRY_ADDRESS=
