{
  "name": "janlekha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && hardhat build --quiet && node scripts/export-abi.mjs --check && tsc -p tsconfig.hardhat.json",
    "contracts:build": "hardhat build && node scripts/export-abi.mjs",
    "contracts:test": "hardhat test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "contracts:node": "hardhat node",
    "contracts:deploy:hedera": "hardhat run scripts/deploy.ts --network hederaTestnet",
    "contracts:roles:hedera": "hardhat run scripts/grant-roles.ts --network hederaTestnet",
    "contracts:smoke:hedera": "hardhat run scripts/smoke-test.ts --network hederaTestnet",
    "contracts:release:hedera": "npm run contracts:deploy:hedera && npm run contracts:roles:hedera && npm run contracts:smoke:hedera",
    "contracts:deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "contracts:roles:local": "hardhat run scripts/grant-roles.ts --network localhost",
    "contracts:smoke:local": "hardhat run scripts/smoke-test.ts --network localhost",
    "contracts:seed:local": "hardhat run scripts/seed-demo.ts --network localhost",
    "demo:documents": "hardhat run scripts/demo-documents.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "hardhat": "^3.21.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
