# Copy to .env and fill in. Never commit .env.
# Hackathon deployment: synthetic data and Hedera *testnet* only.

# ── Server-only ─────────────────────────────────────────────────────────────
# Never give these a NEXT_PUBLIC_ prefix; that would ship them to the browser.

# PostgreSQL (off-chain metadata only; Hedera contract state is authoritative)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/janlekha?schema=public"

# Used only by the Hardhat deployment scripts (never read by Next.js).
HEDERA_TESTNET_RPC_URL="https://testnet.hashio.io/api"
# 32-byte hex ECDSA (secp256k1) key of a throwaway, faucet-funded testnet account.
# ED25519/DER keys cannot sign EVM transactions. Alternative to .env:
#   npx hardhat keystore set HEDERA_TESTNET_PRIVATE_KEY
HEDERA_TESTNET_PRIVATE_KEY=""
HEDERA_MIRROR_NODE_URL="https://testnet.mirrornode.hedera.com"

# Synthetic demo accounts for `npm run contracts:roles:hedera` (public addresses only, no keys).
JANLEKHA_DEMO_DEPARTMENT=""
JANLEKHA_DEMO_VENDORS=""   # comma-separated, e.g. 0xabc…,0xdef…
JANLEKHA_DEMO_INSPECTOR=""
JANLEKHA_DEMO_PAO=""

# ── Public (inlined into the browser bundle) ────────────────────────────────
NEXT_PUBLIC_HEDERA_CHAIN_ID="296"
NEXT_PUBLIC_HEDERA_RPC_URL="https://testnet.hashio.io/api"
NEXT_PUBLIC_HASHSCAN_URL="https://hashscan.io/testnet"
# Set after deployment.
NEXT_PUBLIC_JANLEKHA_CONTRACT_ADDRESS=""
