DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
ATTESTER_PRIVATE_KEY=0xYOUR_ATTESTER_PRIVATE_KEY
ATTESTER_ADDRESS=0xYOUR_ATTESTER_ADDRESS
# Arc defaults to system USDC; only local networks auto-deploy MockUSDC
# USDC_ADDRESS=0xYOUR_USDC_ADDRESS
ARC_RPC_URL=https://rpc.testnet.arc.io
ETHERSCAN_API_KEY=YOUR_EXPLORER_API_KEY
# Optional window overrides (seconds)
# COMMIT_WINDOW=300
# REVEAL_WINDOW=300
# CLAIM_DURATION=3600

# ── JanLekha (Arc Testnet registries) ────────────────────────────────────────
# The JanLekha port is deployed from contracts/src with the same deployer
# key and RPC as StreetSync. The deploy script writes
# contracts/deployments/arcTestnet-janlekha.json, which the backend indexer
# reads. No JanLekha contract is deployed yet; see docs/ARC-MIGRATION.md.
# Leave the addresses below empty until deployment; they are overrides for
# the artifact when set.
JANLEKHA_ROLE_REGISTRY_ADDRESS=
JANLEKHA_BUDGET_REGISTRY_ADDRESS=
JANLEKHA_PROJECT_REGISTRY_ADDRESS=
JANLEKHA_PROCUREMENT_REGISTRY_ADDRESS=
JANLEKHA_MILESTONE_REGISTRY_ADDRESS=
JANLEKHA_PAYMENT_REGISTRY_ADDRESS=
JANLEKHA_DOCUMENT_REGISTRY_ADDRESS=
JANLEKHA_AUDIT_REGISTRY_ADDRESS=
JANLEKHA_DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet-janlekha.json
JANLEKHA_DEPLOYMENT_BLOCK=
