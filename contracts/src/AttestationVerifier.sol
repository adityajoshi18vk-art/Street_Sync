pragma solidity 0.8.24;

// ─────────────────────────────────────────────────────────────────────────────
//  AttestationVerifier.sol
//  EIP-712 signature verifier for backend World-ID v4 attestations.
//
//  Domain:  StreetSync / 1
//  TypeHash: Attestation(address wallet,uint8 role,uint256 bountyId,uint256 nonce,uint64 expiry)
//  Chain:   Arc Testnet (5042002)
//
//  Security:
//   • usedNonces[wallet][nonce] prevents replay.
//   • expiry check prevents stale attestations.
//   • ecrecover result compared to configurable `attester` address.
// ─────────────────────────────────────────────────────────────────────────────

import "./StreetSyncTypes.sol";

abstract contract AttestationVerifier {
    // ─── EIP-712 ─────────────────────────────────────────────────────────────

    /// @dev keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
    bytes32 private constant DOMAIN_TYPE_HASH =
        keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");

    /// @dev keccak256("Attestation(address wallet,uint8 role,uint256 bountyId,uint256 nonce,uint64 expiry)")
    bytes32 private constant ATTESTATION_TYPE_HASH =
        keccak256("Attestation(address wallet,uint8 role,uint256 bountyId,uint256 nonce,uint64 expiry)");

    bytes32 private immutable DOMAIN_SEPARATOR;

    // ─── State ────────────────────────────────────────────────────────────────

    /// @notice Backend signer whose private key produces attestation signatures.
    address public attester;

    /// @notice Tracks consumed nonces per wallet to prevent replay.
    mapping(address => mapping(uint256 => bool)) public usedNonces;

    // ─── Events / Errors (re-exported for readability) ───────────────────────

    // (defined in StreetSyncTypes.sol)

    // ─── Constructor ──────────────────────────────────────────────────────────

    constructor(address _attester) {
        if (_attester == address(0)) revert Unauthorized();
        attester = _attester;

        DOMAIN_SEPARATOR = _buildDomainSeparator();
    }

    // ─── Internal helpers ─────────────────────────────────────────────────────

    /// @dev Builds the EIP-712 domain separator at deploy time.
    function _buildDomainSeparator() private view returns (bytes32) {
        return keccak256(
            abi.encode(
                DOMAIN_TYPE_HASH,
                keccak256(bytes("StreetSync")),
                keccak256(bytes("1")),
                block.chainid,
                address(this)
            )
        );
    }

    /// @notice Returns the domain separator used for EIP-712 encoding.
    function domainSeparator() external view returns (bytes32) {
        return DOMAIN_SEPARATOR;
    }

    /// @dev Verifies an attestation and consumes the nonce.
    ///      Reverts with {NonceAlreadyUsed}, {AttestationExpired}, or {InvalidAttestation}.
    ///
    /// @param wallet       Address the attestation is issued for (must equal msg.sender at call site).
    /// @param role         Role claimed by the wallet.
    /// @param bountyId     Bounty scope (0 for Reviewer registration).
    /// @param nonce        Unique nonce generated by the backend.
    /// @param expiry       Unix timestamp after which the signature is invalid.
    /// @param sig          65-byte ECDSA signature (r ++ s ++ v).
    function _verifyAttestation(
        address wallet,
        Role    role,
        uint256 bountyId,
        uint256 nonce,
        uint64  expiry,
        bytes calldata sig
    ) internal {
        // 1. Replay protection
        if (usedNonces[wallet][nonce]) revert NonceAlreadyUsed();

        // 2. Expiry
        if (block.timestamp > expiry) revert AttestationExpired();

        // 3. Reconstruct EIP-712 digest
        bytes32 structHash = keccak256(
            abi.encode(
                ATTESTATION_TYPE_HASH,
                wallet,
                uint8(role),
                bountyId,
                nonce,
                expiry
            )
        );
        bytes32 digest = keccak256(abi.encodePacked("\x19\x01", DOMAIN_SEPARATOR, structHash));

        // 4. Recover signer
        address signer = _recoverSigner(digest, sig);
        if (signer != attester) revert InvalidAttestation();

        // 5. Mark nonce consumed
        usedNonces[wallet][nonce] = true;
    }

    /// @dev Pure ECDSA recovery from a 65-byte compact signature.
    function _recoverSigner(bytes32 digest, bytes calldata sig) private pure returns (address) {
        if (sig.length != 65) revert InvalidAttestation();

        bytes32 r;
        bytes32 s;
        uint8   v;
        assembly {
            // sig.offset is the calldata byte offset of the sig bytes
            r := calldataload(sig.offset)
            s := calldataload(add(sig.offset, 32))
            v := byte(0, calldataload(add(sig.offset, 64)))
        }
        // Normalise Ethereum's legacy v encoding
        if (v < 27) v += 27;
        if (v != 27 && v != 28) revert InvalidAttestation();

        address recovered = ecrecover(digest, v, r, s);
        if (recovered == address(0)) revert InvalidAttestation();
        return recovered;
    }

    // ─── Owner-callable setter (delegated to inheriting contract) ─────────────

    /// @dev Internal setter so StreetSyncEscrow can expose an owner-guarded wrapper.
    function _setAttester(address newAttester) internal {
        if (newAttester == address(0)) revert Unauthorized();
        attester = newAttester;
        emit AttesterUpdated(newAttester);
    }
}
