# ─── StreetSync Backend Environment Variables ───────────────────────────────
# Copy to .env and fill in real values before running.

# Arc Testnet RPC (primary chain)
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Local Hardhat fallback for dev (auto-detected if ARC_RPC_URL is unreachable)
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# EIP-712 Attestation Signer
# Must match the ATTESTER_ADDRESS configured in the Hardhat StreetSyncEscrow deployment.
ATTESTER_PRIVATE_KEY=0xYOUR_ATTESTER_PRIVATE_KEY
ATTESTER_SIGNER_ADDRESS=0xYOUR_ATTESTER_ADDRESS

# World ID 4.0 (developer.world.org): app_id, rp_id and the server-only RP signing key
WORLD_APP_ID=app_YOUR_WORLD_APP_ID
WORLD_RP_ID=rp_YOUR_RP_ID
WORLD_RP_SIGNING_KEY=0xYOUR_RP_SIGNING_KEY
# production (World App) or staging (World ID simulator)
WORLD_ID_ENVIRONMENT=production
WORLD_ACTION_WORKER=claim-bounty
WORLD_ACTION_REVIEWER=register-reviewer

# Local-only proof bypass: requires CHAIN_ID=31337 and request dev_bypass=true
ALLOW_DEV_WORLD_ID_BYPASS=false

# Deployed contract address (StreetSyncEscrow — the single entry-point contract)
ESCROW_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_ESCROW_ADDRESS

# Path to Hardhat deployment artifacts (relative to backend/)
# If this file exists, the backend reads the escrow address + ABI from it.
DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet.json

# Server
BACKEND_PORT=3001
HOST=0.0.0.0

# SQLite database path (relative to backend/)
DB_PATH=data/streetsync.db


# Arkiv evidence relay (Rabdi testnet). Access key from hub.arkiv.network/access-keys;
# fund the writer address with tGLM at hub.arkiv.network/faucet.
ARKIV_ACCESS_KEY=YOUR_ARKIV_ACCESS_KEY
ARKIV_PRIVATE_KEY=0xYOUR_ARKIV_WRITER_PRIVATE_KEY

# Neighbour (problem-validation) World ID action and proximity gate
WORLD_ACTION_NEIGHBOUR=vote-problem
# Max distance (km) between a neighbour's GPS fix and the reported pin
NEIGHBOUR_RADIUS_KM=10
