# Arc Testnet RPC
ARC_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Local fallback
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# EIP-712 Attester Key (Can be any valid 32-byte hex private key for local dev)
# Default below is standard Hardhat test account #0
ATTESTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ATTESTER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# World ID
WORLD_APP_ID=app_401e8c235a6b3bbd1bc62df14d5c021d
WORLD_ACTION_PREFIX=streetsync
ALLOW_DEV_WORLD_ID_BYPASS=true

# Contract
DEPLOYMENTS_PATH=../contracts/deployments/localhost.json

# Server
BACKEND_PORT=3001
HOST=0.0.0.0
DB_PATH=data/streetsync.db

# ── Arc Testnet ──────────────────────────────────────────────────────────────
# Put these in backend/.env.arc (gitignored). `npm run dev` / `npm start` load it when present.
# CHAIN_ID=5042002
# ATTESTER_PRIVATE_KEY=0x<fresh private key, never Hardhat's test key>
# ATTESTER_ADDRESS=0x<its address — pass the same value to the deploy script>
# DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet.json
# DB_PATH=data/streetsync-arc.db

# ── JanLekha (Arc Testnet registries) ────────────────────────────────────────
# Addresses of the eight JanLekha registries once deployed to Arc Testnet
# (contracts/deployments/arcTestnet-janlekha.json). Leave empty until the
# contracts agent deploys them; with none set, JanLekha indexing is
# disabled and GET /api/janlekha/status reports not deployed. Testnet only.
JANLEKHA_ROLE_REGISTRY_ADDRESS=
JANLEKHA_BUDGET_REGISTRY_ADDRESS=
JANLEKHA_PROJECT_REGISTRY_ADDRESS=
JANLEKHA_PROCUREMENT_REGISTRY_ADDRESS=
JANLEKHA_MILESTONE_REGISTRY_ADDRESS=
JANLEKHA_PAYMENT_REGISTRY_ADDRESS=
JANLEKHA_DOCUMENT_REGISTRY_ADDRESS=
JANLEKHA_AUDIT_REGISTRY_ADDRESS=
# Path to the JanLekha deployment artifact (used when an address above is empty)
JANLEKHA_DEPLOYMENTS_PATH=../contracts/deployments/arcTestnet-janlekha.json
# Block the JanLekha registries were deployed in (optional; read from the artifact when empty)
JANLEKHA_DEPLOYMENT_BLOCK=
# Indexer tuning (optional; defaults: 8000 ms poll, 5 block confirmation lag on Arc)
# INDEXER_POLL_INTERVAL_MS=
# INDEXER_CONFIRMATION_LAG=

# ── JanLekha World ID (citizen participation only) ───────────────────────────
# Optional separate World ID app for JanLekha. When empty, the shared
# WORLD_APP_ID / WORLD_RP_ID above are used. No real values here: create
# the app at https://developer.worldcoin.org and fill in your own ids.
# If the app id or RP id is missing, POST /api/worldid/janlekha/verify
# fails closed with a 503 setup message. World ID proves uniqueness only;
# it grants no official JanLekha role.
JANLEKHA_WORLD_APP_ID=
JANLEKHA_WORLD_RP_ID=
# Action names are derived per item by the backend (janlekha-feedback-,
# janlekha-complaint-, janlekha-community-review- plus the bytes32 id);
# create matching actions in the World Developer Portal before going live.
# The dev bypass (ALLOW_DEV_WORLD_ID_BYPASS) is NOT honored for JanLekha.
