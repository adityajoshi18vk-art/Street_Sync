{
  "name": "streetsync-backend",
  "version": "1.0.0",
  "description": "StreetSync backend – World ID v4 attestation signer, EIP-712 signer, Arc event indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "DB_PATH=data/test.db tsx --test test/*.test.ts",
    "db:reset": "rm -f data/streetsync.db && tsx src/server.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@fastify/cors": "^11.0.0",
    "@streetsync/arkiv-client": "^1.0.0",
    "@streetsync/evidence": "^1.0.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "@worldcoin/idkit-server": "^1.2.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "pino-pretty": "^13.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
