{
  "name": "streetsync-app",
  "version": "1.0.0",
  "description": "StreetSync – mobile-first Next.js PWA for Arc Testnet bounties, World ID v4 verification, and verifiable evidence bundles",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:fresh": "npm run clean && next dev",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aliimam/icons": "^1.1.3",
    "@aliimam/logos": "^1.0.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@radix-ui/react-separator": "^1.2.0",
    "@streetsync/arkiv-client": "^1.0.0",
    "@streetsync/evidence": "^1.0.0",
    "@streetsync/swarm-client": "^1.0.0",
    "@tanstack/react-query": "^5.51.23",
    "@worldcoin/idkit": "^4.6.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^5.24.0",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.6.1",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
