# ── Network / Chain ─────────────────────────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WC_PROJECT_ID
# 5042002 = Arc Testnet (default), 31337 = Local Hardhat
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_LOCALHOST_RPC_URL=http://127.0.0.1:8545

# ── Backend (World ID attestation signer + indexer API) ────────────────────
NEXT_PUBLIC_API_URL=
# Server-only upstream for the same-origin /api proxy
BACKEND_API_URL=http://127.0.0.1:3001

# ── World ID 4.0 (IDKit 4) ──────────────────────────────────────────────────
# The app ID, rp_id and signing key live on the backend; it hands the browser a signed request.
# Actions must match the backend's World ID dashboard configuration.
NEXT_PUBLIC_WORLD_APP_ID=app_401e8c235a6b3bbd1bc62df14d5c021d
NEXT_PUBLIC_WORLD_ACTION_WORKER=claim-bounty
NEXT_PUBLIC_WORLD_ACTION_REVIEWER=register-reviewer
NEXT_PUBLIC_WORLD_ACTION_NEIGHBOUR=vote-problem
# Minimum World ID credential: device (any verified World ID, default) | document | secure_document | orb
NEXT_PUBLIC_WORLD_ID_LEVEL=device

# ── Arkiv entity store ──────────────────────────────────────────────────────
# http  = write/read evidence entities through the backend Arkiv relay
# local = browser-local store, allowed only with chain ID 31337
NEXT_PUBLIC_ARKIV_MODE=http
# Optional override; defaults to the backend relay at /api/arkiv
# NEXT_PUBLIC_ARKIV_URL=

# ── Ethereum Swarm (Video Walkthrough Storage) ─────────────────────────────
NEXT_PUBLIC_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
NEXT_PUBLIC_SWARM_POSTAGE_BATCH_ID=
NEXT_PUBLIC_SWARM_MODE=auto

# Link to JanLekha, the spending-transparency feature of the same project (unified under port 3000).
NEXT_PUBLIC_JANLEKHA_URL=/janlekha
