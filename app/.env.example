# ── Network toggle ──────────────────────────────────────────────────────────
# 5042002 = Arc Testnet (default). Set to 31337 to run against a local Hardhat node.
NEXT_PUBLIC_CHAIN_ID=5042002

# Overrides for contracts/deployments/<network>.json addresses (optional).
# Useful for local Hardhat where each node restart changes addresses.
# NEXT_PUBLIC_ESCROW_ADDRESS=0x...
# NEXT_PUBLIC_USDC_ADDRESS=0x...

# ── Arc Testnet ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# ── Local Hardhat ───────────────────────────────────────────────────────────
NEXT_PUBLIC_LOCALHOST_RPC_URL=http://127.0.0.1:8545

# ── Backend (World ID attestation signer + indexer API) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
# Behind a tunnel/preview URL, use the built-in same-origin proxy instead:
# NEXT_PUBLIC_API_URL=/backend

# ── World ID v4 (IDKit) ─────────────────────────────────────────────────────
# Obtain from https://developer.worldcoin.org. Example dev app: app_staging_...
NEXT_PUBLIC_WORLD_APP_ID=app_401e8c235a6b3bbd1bc62df14d5c021d
# Worker claims use "<WORKER>-<bountyId>" (auto-created per bounty); must match the backend.
NEXT_PUBLIC_WORLD_ACTION_WORKER=claim-bounty
NEXT_PUBLIC_WORLD_ACTION_REVIEWER=register-reviewer

# ── Arkiv entity store ──────────────────────────────────────────────────────
# http  = write/read evidence entities against the Arkiv gateway below
# local = browser-local localStorage store (bytes32-shaped keys) for offline demos
NEXT_PUBLIC_ARKIV_MODE=local
NEXT_PUBLIC_ARKIV_URL=https://arp.testnet.arkiv.golem.network
# NEXT_PUBLIC_ARKIV_API_KEY=

# Link to JanLekha, the spending-transparency feature of the same project (unified under port 3000).
NEXT_PUBLIC_JANLEKHA_URL=/janlekha
