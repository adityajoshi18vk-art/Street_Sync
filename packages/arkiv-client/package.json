{
  "name": "@streetsync/arkiv-client",
  "version": "1.0.0",
  "description": "StreetSync Arkiv SDK wrapper – entity write, read, chunking, bytes32 key conversion, and cryptographic audit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@streetsync/evidence": "^1.0.0",
    "cbor-x": "^1.6.0",
    "fzstd": "^0.1.1",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@arkiv-network/sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@arkiv-network/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
